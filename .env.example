# ── Z.ai / GLM backend (Anthropic-compatible endpoint) ──────────────────────
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_AUTH_TOKEN=            # Z.ai GLM Coding Plan key (the working $ZAI_TOKEN)
API_TIMEOUT_MS=3000000
# Claude model names -> GLM models (the SDK requests Claude names; map them)
ANTHROPIC_DEFAULT_HAIKU_MODEL=glm-4.5-air
ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5-turbo
ANTHROPIC_DEFAULT_OPUS_MODEL=glm-5.1
# Required: container runs as root; the Claude Code engine refuses bypass as root
# unless this is set.
IS_SANDBOX=1

# ── Slack (Socket Mode) ─────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...         # Socket Mode app-level token
# Scopes: chat:write, app_mentions:read, channels:history, groups:history,
#         im:history, im:read, im:write, users:read, files:read, files:write
# Event subscriptions: message.channels, message.groups, message.im, app_mention

# ── Session map (Railway Postgres) ──────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Workspace / git ─────────────────────────────────────────────────────────
AGENT_WORKSPACE=/data/seomachine
AGENT_DRAFTS_BRANCH=agent/drafts
PROTECTED_BRANCHES=main,context/rise4-specifics
SEOMACHINE_BRANCH=context/rise4-specifics
GITHUB_TOKEN=                    # fine-grained PAT, Contents:RW on rise4-seomachine (mattrise4)
GIT_AUTHOR_NAME=Rise4 SEO Agent
GIT_AUTHOR_EMAIL=seo-agent@rise4.com

# ── Credentials (base64 of each JSON; materialized to /data at boot) ─────────
GA4_CREDENTIALS_B64=
GSC_CREDENTIALS_B64=
GWS_SA_CREDENTIALS_B64=          # service account that is a member of the Shared Drive

# ── seomachine data pipeline ────────────────────────────────────────────────
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
GA4_PROPERTY_ID=511560293
GSC_SITE_URL=sc-domain:rise4.com
